{
  "name": "mathforge",
  "version": "1.0.0",
  "description": "LaTeX to SVG/PNG Math Compiler",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package-mac": "electron-packager . MathForge --platform=darwin --arch=x64 --out=dist --overwrite",
    "package-win": "electron-packager . MathForge --platform=win32 --arch=x64 --out=dist --overwrite",
    "package-all": "electron-packager . MathForge --platform=darwin,win32 --arch=x64 --out=dist --overwrite"
  },
  "keywords": [
    "latex",
    "svg",
    "png",
    "math",
    "compiler"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.3.0",
    "electron-packager": "^17.1.1"
  }
}
